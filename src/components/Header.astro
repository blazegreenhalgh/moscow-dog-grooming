---
import { Icon } from "astro-icon/components";
import CmsImage from "./CmsImage.astro";
import { phoneHrefFromDisplay } from "../lib/contact";

interface Props {
  content: {
    headerLogo: string;
    phoneDisplay: string;
    navServices: string;
    navPrices: string;
    navGallery: string;
    navReviews: string;
    navContact: string;
    mobilePhoneButton: string;
  };
}

const { content } = Astro.props;
const phoneHref = phoneHrefFromDisplay(content.phoneDisplay);

const navItems = [
  { label: content.navServices, href: "#services" },
  { label: content.navPrices, href: "#prices" },
  { label: content.navGallery, href: "#gallery" },
  { label: content.navReviews, href: "#reviews" },
  { label: content.navContact, href: "#contact" },
];
---

<header
  class="border-cream-50/30 bg-blush-500/95 sticky top-0 z-50 border-b backdrop-blur-md"
>
  <div class="page-shell flex min-h-20 items-center justify-between gap-6">
    <a href="/" aria-label="Главная" class="focus-ring shrink-0 rounded-xl">
      <CmsImage
        src={content.headerLogo}
        alt=""
        class="w-38 sm:w-44 lg:w-48"
        width="1200"
        height="416"
        widths={[152, 304, 384]}
        sizes="(min-width: 1024px) 12rem, (min-width: 640px) 11rem, 9.5rem"
        priority
      />
    </a>

    <nav
      class="hidden items-center gap-7 lg:flex"
      aria-label="Основная навигация"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="focus-ring text-cream-50 hover:text-cocoa-900 rounded-lg text-sm transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={phoneHref}
      class="focus-ring border-cream-50/80 text-cream-50 hover:bg-cream-50 hidden rounded-full border px-4 py-2 text-sm transition-colors hover:text-orange-600 sm:inline-flex"
    >
      {content.phoneDisplay}
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="focus-ring border-cream-50/70 text-cream-50 relative flex size-12 items-center justify-center rounded-full border lg:hidden"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="mobile-menu" class="stroke-cream-50 size-6 shrink-0" />
      <span
        class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden"
        aria-hidden="true"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="bg-blush-500 grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-300 data-open:grid-rows-[1fr] lg:hidden"
  >
    <div class="min-h-0">
      <nav
        class="page-shell border-cream-50/30 border-t py-6"
        aria-label="Мобильная навигация"
      >
        <ul role="list" class="flex flex-col gap-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="focus-ring text-cream-50 hover:bg-cream-50/15 flex min-h-12 items-center rounded-xl px-3 text-base transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-3">
            <a
              href={phoneHref}
              class="focus-ring border-cream-50/80 text-cream-50 flex min-h-12 items-center justify-center rounded-full border px-4 text-base"
            >
              {content.mobilePhoneButton}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const menuLinks = menu?.querySelectorAll("a");

  const closeMenu = () => {
    menu?.removeAttribute("data-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Открыть меню");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.hasAttribute("data-open") ?? false;
    if (isOpen) {
      closeMenu();
      return;
    }

    menu?.setAttribute("data-open", "");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Закрыть меню");
  });

  menuLinks?.forEach((link) => link.addEventListener("click", closeMenu));
</script>
